{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/school-science-dataset/experiment.schema.json",
  "title": "School Science Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "subject",
    "class_level",
    "title",
    "difficulty",
    "educational_goal",
    "materials",
    "procedure_steps",
    "scenes",
    "sources",
    "image_assets",
    "evidence",
    "status"
  ],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^(chem|phy)_(8|9|10|11|12)_[0-9]{3,4}$"},
    "subject": {"type": "string", "enum": ["Chemistry", "Physics"]},
    "class_level": {"type": "integer", "enum": [8, 9, 10, 11, 12]},
    "chapter": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
    "educational_goal": {"type": "string", "minLength": 20},
    "concepts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "materials": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "safety_notes": {"type": "array", "items": {"type": "string"}},
    "procedure_steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "instruction", "observation"],
        "properties": {
          "step_id": {"type": "integer", "minimum": 1},
          "instruction": {"type": "string", "minLength": 5},
          "observation": {"type": "string", "minLength": 5},
          "scene_ids": {"type": "array", "items": {"type": "string"}},
          "scene_link_status": {"type": "string", "enum": ["needs_review", "verified", "rejected"]},
          "presentation": {"type": "string", "enum": ["physical", "overlay"]}
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "name", "description", "visible_actions", "image_asset_id"],
        "properties": {
          "scene_id": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 20},
          "visible_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "image_asset_id": {"type": "string"}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "url", "citation", "verification_status"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"type": "string", "enum": ["ncert_textbook", "ncert_lab_manual", "reference"]},
          "url": {"type": "string", "format": "uri"},
          "citation": {"type": "string", "minLength": 5},
          "verification_status": {"type": "string", "enum": ["needs_page_check", "verified"]},
          "passage_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "image_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["image_asset_id", "role", "url", "license_status"],
        "properties": {
          "image_asset_id": {"type": "string"},
          "role": {"type": "string", "enum": ["starting_image", "scene_reference"]},
          "url": {"type": "string"},
          "license_status": {"type": "string", "enum": ["placeholder", "needs_review", "verified"]},
          "attribution": {"type": "string"}
        }
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section_ids", "source_verification", "retrieval_eligibility", "video_readiness", "claims", "legacy_source_statuses"],
      "properties": {
        "section_ids": {"type": "array", "items": {"type": "string"}},
        "source_verification": {"type": "string", "enum": ["unverified", "partially_verified", "verified", "no_link_in_supplied_pdfs"]},
        "retrieval_eligibility": {"type": "string", "enum": ["review_required", "eligible", "ineligible"]},
        "video_readiness": {"type": "string", "enum": ["review_required", "ready", "ineligible"]},
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "field_path", "text", "kind", "passage_ids", "review_status"],
            "properties": {
              "claim_id": {"type": "string"},
              "field_path": {"type": "string"},
              "text": {"type": "string"},
              "kind": {"type": "string", "enum": ["action", "observation", "quantity", "safety", "material", "scene"]},
              "passage_ids": {"type": "array", "items": {"type": "string"}},
              "review_status": {"type": "string", "enum": ["needs_review", "verified", "rejected"]}
            }
          }
        },
        "legacy_source_statuses": {"type": "array", "items": {"type": "object"}}
      }
    },
    "status": {"type": "string", "enum": ["draft", "source_review", "ready"]}
  }
}
